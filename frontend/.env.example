# Nhost Configuration
NEXT_PUBLIC_NHOST_SUBDOMAIN=your-subdomain
NEXT_PUBLIC_NHOST_REGION=eu-central-1

# Nhost Backend (for server-side operations)
NHOST_SUBDOMAIN=your-subdomain
NHOST_REGION=eu-central-1
HASURA_ADMIN_SECRET=your-hasura-admin-secret
HASURA_GRAPHQL_URL=https://your-subdomain.eu-central-1.nhost.app/v1/graphql

# Nhost Auth
NHOST_JWT_SECRET=your-jwt-secret

# LLM API Keys (optional - will use stubs if not provided)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Encryption Key (for API credentials)
ENCRYPTION_KEY=your-encryption-key-min-32-chars
